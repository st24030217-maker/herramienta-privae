{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/app/api/process/**/route.ts": {
      "maxDuration": 60,
      "memory": 3008
    },
    "src/app/api/cron/lifecycle/route.ts": {
      "maxDuration": 60
    }
  }
}
