# ==============================================================================
# 1. BASE DE DATOS (PostgreSQL en Producción / SQLite en Desarrollo)
# ==============================================================================
DATABASE_URL="file:./dev.db"

# ==============================================================================
# 2. SEGURIDAD, SESIONES JWT Y ADMINISTRACIÓN
# ==============================================================================
# Secreto obligatorio en producción para firmar cookies HttpOnly JWT (generar con: openssl rand -base64 48)
JWT_SECRET="privae_super_secure_jwt_secret_key_dtf_prepress_2026"

# Correos separados por coma que reciben rol ADMIN automáticamente
ADMIN_EMAIL="admin@privae.com"

# Clave opcional para autorizar registros de administradores
ADMIN_REGISTRATION_KEY="clave_secreta_para_crear_admins_opcional"

# Secreto para autenticar la ejecución diaria automática de /api/cron/lifecycle en Vercel
CRON_SECRET="privae_cron_secret_key_2026"

# ==============================================================================
# 3. INTEGRACIÓN CON TIENDA PRIVAE TEXTIL Y DOMINIO
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_URL="https://privaetextil.com"

# ==============================================================================
# 4. PASARELA DE PAGOS CERTIFICADA (STRIPE)
# ==============================================================================
STRIPE_SECRET_KEY="sk_test_tu_clave_secreta_de_stripe"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_tu_clave_publicable_de_stripe"
STRIPE_WEBHOOK_SECRET="whsec_tu_stripe_webhook_secret"
# Opcional: si se deja vacío, el sistema usa el precio dinámico configurado en el Panel Admin
STRIPE_PRICE_ID=""

# ==============================================================================
# 5. CORREOS TRANSACCIONALES AUTOMÁTICOS (RESEND)
# ==============================================================================
RESEND_API_KEY=""
EMAIL_FROM="Privae Textil <notificaciones@privaetextil.com>"

# ==============================================================================
# 6. CONECTOR OPCIONAL DE IA NEURONAL PARA RECORTE DE CABELLO (01 · REMOVER FONDO)
# ==============================================================================
# Si se configuran, el módulo 01 usa segmentación neuronal en la nube + salida 300 DPI.
# Si se dejan vacías, utiliza automáticamente el motor en servidor con Alpha Matting y Descontaminación Cromática.
REMOVEBG_API_KEY=""
CLIPDROP_API_KEY=""
