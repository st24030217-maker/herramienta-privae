# Secreto para firmar los JWT de sesión.
# ¡OBLIGATORIO en producción! Usa un valor largo y aleatorio.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=

# Correos (separados por coma) que recibirán rol ADMIN al registrarse.
# Deja vacío para que ningún registro sea admin automáticamente.
ADMIN_EMAIL=

# (Opcional) Sobrescribe la URL de la base de datos Prisma.
# DATABASE_URL="file:./dev.db"
