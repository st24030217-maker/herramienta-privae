# URL de conexión a la base de datos (PostgreSQL o SQLite según prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los tokens JWT de sesión.
# ¡OBLIGATORIO en producción! Usa un valor largo y aleatorio generado con: openssl rand -base64 48
JWT_SECRET="privae_super_secure_jwt_secret_key_dtf_prepress_2026"

# Correos (separados por coma) que recibirán rol ADMIN automáticamente al registrarse.
ADMIN_EMAIL="admin@privae.com"

# Clave secreta para autorizar registros con rol ADMIN (opcional, protege /api/auth/register)
ADMIN_REGISTRATION_KEY="clave_secreta_para_crear_admins_opcional"

# Configuración de Pasarela de Pagos Stripe
# Obtén tus claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_tu_clave_secreta_de_stripe"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_tu_clave_publicable_de_stripe"

# Secreto para verificar webhooks de Stripe (obtenlo en el dashboard de Stripe o via stripe listen)
STRIPE_WEBHOOK_SECRET="whsec_tu_stripe_webhook_secret"

# ID de Precio recurrente en Stripe ($19.99 USD/mes). Si se deja vacío, el sistema crea dinámicamente el precio de $19.99/mes.
STRIPE_PRICE_ID=""

# URL pública de la aplicación para redirecciones de Stripe
NEXT_PUBLIC_APP_URL="http://localhost:3000"
